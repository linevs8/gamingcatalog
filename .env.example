# Server-only credentials for the optional IGDB integration.
# Get a Twitch Client ID and confidential-app Client Secret:
# https://dev.twitch.tv/console
# Do NOT prefix these names with NEXT_PUBLIC_.
# Do NOT commit real values or send the secret in chat.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Public Supabase browser settings, safe to expose as NEXT_PUBLIC_ values.
# The service_role key must NEVER be placed in frontend env settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" only after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
