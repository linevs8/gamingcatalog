{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.playquill.desktop",
  "productName": "Playquill",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app-server",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Playquill-${version}-${arch}-${os}.${ext}"
  },
  "publish": null,
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Playquill",
    "artifactName": "Playquill-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "Playquill-Portable-${version}-${arch}.${ext}"
  }
}
